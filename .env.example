# Copy to `.env` at the project root:
#   cp .env.example .env
#
# Never commit `.env` with real secrets.
# See README.md for the full setup guide (dev and prod).

# =============================================================================
# REQUIRED — development and production
# =============================================================================

# PostgreSQL
# Dev (docker compose): use the URL below.
# Prod: connection string from your managed Postgres (Neon, Supabase, Vercel Postgres, etc.).
DATABASE_URL="postgresql://erp:erp@localhost:5433/shopping1a1?schema=public"

# Mercado Livre OAuth — app at https://developers.mercadolivre.com.br/
MERCADOLIBRE_CLIENT_ID=""
MERCADOLIBRE_CLIENT_SECRET=""

# Dev: local redirect. Prod: https://YOUR-DOMAIN/api/auth/mercadolibre/callback
# Must match EXACTLY what is registered in the ML app.
MERCADOLIBRE_REDIRECT_URI="http://localhost:3000/api/auth/mercadolibre/callback"

# Encrypts ML tokens in `ml_seller_credentials` (AES-256-GCM).
# Generate once and keep safe: openssl rand -base64 32
# Do not rotate after the first login without re-encrypting existing rows.
ENCRYPTION_KEY=""

# =============================================================================
# PRODUCTION — Vercel + cron-job.org (catalog cron)
# =============================================================================

# Protects POST /api/cron/catalog-competition (Bearer token).
# Generate: openssl rand -base64 32
# Set on Vercel, then use the same value in cron-job.org — 1 job só, roda
# 1x/hora, não importa quantos tenants existam (o fan-out por organização
# pagante acontece dentro da rota, em lotes rotativos):
#   URL:  https://YOUR-DOMAIN.vercel.app/api/cron/catalog-competition
#   Method: POST
#   Header: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# Bugsink (error tracking, SDK compatível com Sentry) — captura exceções do
# servidor (route handlers, SSR) e do navegador (interação do usuário).
# DSN não é secreto (fica embutido no bundle do client), mas mantemos em env
# var pra não hardcodar e pra poder ficar ausente em dev sem enviar ruído.
# Pegue em: https://shopping1a1.bugsink.com
NEXT_PUBLIC_BUGSINK_DSN=""

# =============================================================================
# SAAS — controle manual de pagamento (sem gateway ainda)
# =============================================================================

# Protects PATCH /api/admin/organizations/[id]/status (Bearer token).
# Generate: openssl rand -base64 32
# Usage:
#   curl -X PATCH https://YOUR-DOMAIN/api/admin/organizations/<id>/status \
#     -H "Authorization: Bearer <ADMIN_SECRET>" \
#     -H "Content-Type: application/json" \
#     -d '{"status":"active","note":"pago via Pix em 21/08"}'
ADMIN_SECRET=""

# =============================================================================
# OPTIONAL — local catalog report demo (scripts/seed-catalog-report-demo.ts)
# =============================================================================

# Use mock sale events from .mock/catalog-report-sales.json instead of ML orders API.
# In development the file is picked up automatically after `npm run seed:catalog-demo`.
# Set to 0 to force real ML orders API even when the mock file exists.
# CATALOG_MOCK_SALES="0"

# =============================================================================
# OPTIONAL — ML API overrides (default: Brazil)
# =============================================================================

# MERCADOLIBRE_AUTH_BASE="https://auth.mercadolivre.com.br"
# MERCADOLIBRE_API_BASE="https://api.mercadolibre.com"

# =============================================================================
# OPTIONAL — local simulation scripts (not used at runtime)
# =============================================================================

# Removed: use `npm run seed:catalog-demo` + CATALOG_MOCK_SALES=1 instead.

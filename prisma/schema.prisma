// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Anúncio sincronizado do Mercado Livre (chave = ml_item_id, ex. MLB…).
model Listing {
  mlItemId       String    @id @map("ml_item_id")
  titleSnapshot  String?   @map("title_snapshot")
  skuSnapshot    String?   @map("sku_snapshot")
  imageUrlSnapshot String? @map("image_url_snapshot")
  catalogListing Boolean?  @map("catalog_listing")
  lastSyncedAt   DateTime? @map("last_synced_at")
  activeOnMl     Boolean   @default(true) @map("active_on_ml")
  /// Último status de competição confirmado pelo poll (mesmo sem novo snapshot).
  catalogStatus       CatalogCompetitionStatus? @map("catalog_status")
  catalogSellerPrice  Decimal?                  @map("catalog_seller_price") @db.Decimal(18, 2)
  catalogPriceToWin   Decimal?                  @map("catalog_price_to_win") @db.Decimal(18, 2)
  catalogPolledAt     DateTime?                 @map("catalog_polled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  warehouseStock WarehouseStock?
  competitionSnapshots CatalogCompetitionSnapshot[]
  stockAttentionAcknowledgements StockAttentionAcknowledgement[]
  replenishmentCycles ReplenishmentCycle[]

  @@index([activeOnMl])
  @@map("listings")
}

enum CatalogCompetitionStatus {
  winning
  losing
  shared
  unknown
}

enum CatalogCompetitionSource {
  webhook
  missed_feed
  manual_poll
  cron
}

enum StockAttentionKind {
  full
  purchase
}

enum OperationCycleKind {
  purchase
  full
}

enum ReplenishmentStatus {
  attention
  analyzing
  quoted
  ordered
  scheduled
  collected
  completed
}

/// Ciclo operacional por anúncio (compra ou envio Full), independente por kind.
model ReplenishmentCycle {
  id                    String              @id @default(cuid())
  mlItemId              String              @map("ml_item_id")
  kind                  OperationCycleKind
  status                ReplenishmentStatus
  triggerMlQty          Int                 @map("trigger_ml_qty")
  triggerWarehouseQty   Int                 @map("trigger_warehouse_qty")
  triggerLeadTimeDays   Int?                @map("trigger_lead_time_days")
  triggerPurchaseAt     DateTime?           @map("trigger_purchase_at")
  warehouseQtyAtOrder   Int?                @map("warehouse_qty_at_order")
  /// Estoque ML ao marcar Coletado (baseline para detectar entrada no Full).
  mlQtyAtCollection     Int?                @map("ml_qty_at_collection")
  suggestedQty          Int?                @map("suggested_qty")
  notes                 String?
  completedMlQty        Int?                @map("completed_ml_qty")
  completedWarehouseQty Int?                @map("completed_warehouse_qty")
  completedLeadTimeDays Int?                @map("completed_lead_time_days")
  completedAt           DateTime?           @map("completed_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  listing Listing @relation(fields: [mlItemId], references: [mlItemId], onDelete: Cascade)

  @@index([mlItemId, kind, status])
  @@index([status])
  @@map("replenishment_cycles")
}

model CatalogCompetitionSnapshot {
  id           String                   @id @default(cuid())
  mlItemId     String                   @map("ml_item_id")
  status       CatalogCompetitionStatus
  sellerPrice  Decimal?                 @map("seller_price") @db.Decimal(18, 2)
  priceToWin   Decimal?                 @map("price_to_win") @db.Decimal(18, 2)
  snapshotAt   DateTime                 @default(now()) @map("snapshot_at")
  source       CatalogCompetitionSource @default(manual_poll)
  rawResponse  Json                     @map("raw_response")

  listing Listing @relation(fields: [mlItemId], references: [mlItemId], onDelete: Cascade)

  @@unique([mlItemId, snapshotAt])
  @@index([snapshotAt(sort: Desc)])
  @@index([mlItemId, snapshotAt(sort: Desc)])
  @@map("catalog_competition_snapshots")
}

/// Log de execuções do poll de competição de catálogo (cron ou manual).
model CatalogCompetitionPollRun {
  id           String                   @id @default(cuid())
  ranAt        DateTime                 @default(now()) @map("ran_at")
  source       CatalogCompetitionSource
  itemsChecked Int                      @default(0) @map("items_checked")
  itemsChanged Int                      @default(0) @map("items_changed")
  ok           Boolean                  @default(true)
  errorSummary String?                  @map("error_summary") @db.Text

  @@index([ranAt(sort: Desc)])
  @@map("catalog_competition_poll_runs")
}

/// Estoque físico no galpão (1:1 com listing).
model WarehouseStock {
  mlItemId              String   @id @map("ml_item_id")
  quantity              Int      @default(0)
  /// Prazo compra → chegada no galpão (dias inteiros; UI pode informar em semanas).
  purchaseLeadTimeDays  Int?     @map("purchase_lead_time_days")
  /// Override opcional dos dias de cobertura alvo na análise de compra.
  targetCoverageDays    Int?     @map("target_coverage_days")
  notes                 String?
  updatedAt             DateTime @updatedAt @map("updated_at")

  listing Listing @relation(fields: [mlItemId], references: [mlItemId], onDelete: Cascade)

  @@map("warehouse_stock")
}

/// Cadastro fiscal/comercial por SKU (chave = SKU do anúncio ML).
model Product {
  sku                 String   @id
  ncm                 String?
  unitCostNf          Decimal  @map("unit_cost_nf") @db.Decimal(18, 2)
  purchaseIcmsPercent Decimal  @map("purchase_icms_percent") @db.Decimal(8, 4)
  hasIcmsSt           Boolean  @default(false) @map("has_icms_st")
  purchaseCostWithSt  Decimal? @map("purchase_cost_with_st") @db.Decimal(18, 2)
  ipiPercent          Decimal  @default(0) @map("ipi_percent") @db.Decimal(8, 4)
  extraCosts          Decimal  @default(0) @map("extra_costs") @db.Decimal(18, 2)
  isMonophasic        Boolean  @default(false) @map("is_monophasic")
  saleIcmsPercent     Decimal  @map("sale_icms_percent") @db.Decimal(8, 4)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("products")
}

/// PIS/COFINS global da empresa (uma linha).
model CompanyTaxSettings {
  id               String   @id @default("default")
  pisCofinsPercent Decimal  @map("pis_cofins_percent") @db.Decimal(8, 4)
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("company_tax_settings")
}

/// Avisos de estoque que já receberam ação operacional (ex.: compra feita).
model StockAttentionAcknowledgement {
  id                   String             @id @default(cuid())
  mlItemId             String             @map("ml_item_id")
  kind                 StockAttentionKind
  mlAvailableQuantity  Int                @map("ml_available_quantity")
  warehouseQuantity    Int                @map("warehouse_quantity")
  purchaseLeadTimeDays Int?               @map("purchase_lead_time_days")
  acknowledgedAt       DateTime           @default(now()) @map("acknowledged_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  listing Listing @relation(fields: [mlItemId], references: [mlItemId], onDelete: Cascade)

  @@unique([mlItemId, kind])
  @@index([kind])
  @@map("stock_attention_acknowledgements")
}

/// Tokens OAuth do vendedor ML (até 1 linha por `ml_user_id`) para chamadas server-side (ex.: webhook).
/// `refresh_enc` / `access_enc` são texto cifrado (AES-256-GCM) com `ENCRYPTION_KEY`.
model MlSellerCredentials {
  mlUserId        Int       @id @map("ml_user_id")
  refreshEnc      String    @map("refresh_enc") @db.Text
  accessEnc       String?   @map("access_enc") @db.Text
  accessExpiresAt DateTime? @map("access_expires_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("ml_seller_credentials")
}

/// Push subscriptions Web Push por vendedor/dispositivo.
model PushSubscription {
  id         String   @id @default(cuid())
  mlUserId   Int      @map("ml_user_id")
  endpoint   String   @db.Text
  p256dh     String   @db.Text
  auth       String   @db.Text
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([mlUserId, endpoint])
  @@index([mlUserId])
  @@map("push_subscriptions")
}

/// Item de custo manual do DRE (fixo ou operacional; valor por mês em DreCostMonthValue).
model DreCostItem {
  id          String              @id @default(cuid())
  name        String
  section     DreCostSection      @default(FIXED)
  sortOrder   Int                 @default(0) @map("sort_order")
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  monthValues DreCostMonthValue[]

  @@index([section, active])
  @@map("dre_cost_items")
}

enum DreCostSection {
  FIXED       @map("fixed")
  OPERATIONAL @map("operational")
}

model DreCostMonthValue {
  id         String      @id @default(cuid())
  costItemId String      @map("cost_item_id")
  year       Int
  month      Int
  amount     Decimal     @db.Decimal(18, 2)
  costItem   DreCostItem @relation(fields: [costItemId], references: [id], onDelete: Cascade)

  @@unique([costItemId, year, month])
  @@index([year, month])
  @@map("dre_cost_month_values")
}

/// Snapshot mensal do DRE após sync (linhas ML + ERP + ADS).
model DreMonthSnapshot {
  id       String   @id @default(cuid())
  year     Int
  month    Int
  syncedAt DateTime @map("synced_at")
  payload  Json

  @@unique([year, month])
  @@index([year, month])
  @@map("dre_month_snapshots")
}

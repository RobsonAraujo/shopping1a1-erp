// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  owner
  admin
  member
}

enum OrganizationStatus {
  trialing
  active
  past_due
  canceled
}

/// Cliente SaaS (empresa que usa o ERP). Login continua sendo só OAuth do
/// Mercado Livre — `Organization` é resolvida a partir do `mlUserId` da
/// sessão via `OrganizationMlSeller`, não por um login próprio do ERP.
model Organization {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  /// Status de pagamento — trocado manualmente por enquanto (rota admin ou
  /// Prisma Studio). Desenhado para um gateway real (Mercado Pago/Stripe)
  /// escrever aqui via webhook no futuro, sem nova migration.
  status          OrganizationStatus @default(trialing)
  statusUpdatedAt DateTime           @default(now()) @map("status_updated_at")
  statusNote      String?            @map("status_note") @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  members   OrganizationMember[]
  mlSellers OrganizationMlSeller[]

  @@map("organizations")
}

/// Pessoa com acesso ao ERP. Hoje só existe 1 User por Organization (o dono,
/// criado automaticamente no primeiro login OAuth do ML) — o modelo já vem
/// pronto para múltiplos usuários por organização numa fase futura.
model User {
  id        String   @id @default(cuid())
  /// Nullable: a resposta de /users/me do ML (UserMe.email?: string) não
  /// garante e-mail. Não é usado para autenticação — login é sempre por
  /// mlUserId via OrganizationMlSeller.
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships OrganizationMember[]

  @@map("users")
}

model OrganizationMember {
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole @default(owner)
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@map("organization_members")
}

/// Vínculo entre uma organização e uma conta ML. `mlUserId` é único: 1 seller
/// ML pertence a no máximo 1 organização.
model OrganizationMlSeller {
  organizationId          String    @map("organization_id")
  mlUserId                Int       @map("ml_user_id")
  isPrimary               Boolean   @default(true) @map("is_primary")
  linkedAt                DateTime  @default(now()) @map("linked_at")
  /// Última vez que o cron de catálogo processou este seller — usado pra
  /// rotacionar o lote a cada execução (mais antigo primeiro), sem precisar
  /// de uma tabela de cursor separada. Atualizado mesmo em caso de erro, pra
  /// um seller com falha não travar a rotação dos outros.
  lastCatalogCronPolledAt DateTime? @map("last_catalog_cron_polled_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, mlUserId])
  @@unique([mlUserId])
  @@map("organization_ml_sellers")
}

/// Anúncio sincronizado do Mercado Livre (chave = ml_item_id, ex. MLB…).
model Listing {
  mlItemId           String                    @id @map("ml_item_id")
  organizationId     String                    @map("organization_id")
  titleSnapshot      String?                   @map("title_snapshot")
  skuSnapshot        String?                   @map("sku_snapshot")
  imageUrlSnapshot   String?                   @map("image_url_snapshot")
  catalogListing     Boolean?                  @map("catalog_listing")
  lastSyncedAt       DateTime?                 @map("last_synced_at")
  activeOnMl         Boolean                   @default(true) @map("active_on_ml")
  /// Status ML do anúncio (`active`, `paused`, …); preenchido no poll/sync.
  mlStatus           String?                   @map("ml_status")
  /// Último status de competição confirmado pelo poll (mesmo sem novo snapshot).
  catalogStatus      CatalogCompetitionStatus? @map("catalog_status")
  catalogSellerPrice Decimal?                  @map("catalog_seller_price") @db.Decimal(18, 2)
  catalogPriceToWin  Decimal?                  @map("catalog_price_to_win") @db.Decimal(18, 2)
  catalogPolledAt    DateTime?                 @map("catalog_polled_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  warehouseStock                 WarehouseStock?
  competitionSnapshots           CatalogCompetitionSnapshot[]
  stockAttentionAcknowledgements StockAttentionAcknowledgement[]
  replenishmentCycles            ReplenishmentCycle[]

  @@index([activeOnMl])
  @@index([organizationId])
  @@map("listings")
}

enum CatalogCompetitionStatus {
  winning
  losing
  shared
  unknown
}

enum CatalogCompetitionSource {
  webhook
  missed_feed
  manual_poll
  cron
}

enum StockAttentionKind {
  full
  purchase
}

enum OperationCycleKind {
  purchase
  full
}

enum ReplenishmentStatus {
  attention
  analyzing
  quoted
  ordered
  scheduled
  collected
  completed
}

enum FullShipmentSource {
  manual
  ml_billing
}

/// Envio de estoque ao Mercado Livre Full (coleta) com custo e unidades.
model FullShipment {
  id                String             @id @default(cuid())
  organizationId    String             @map("organization_id")
  shippedAt         DateTime           @map("shipped_at")
  totalCost         Decimal            @map("total_cost") @db.Decimal(18, 2)
  nonComplianceCost Decimal            @default(0) @map("non_compliance_cost") @db.Decimal(18, 2)
  totalUnits        Int                @map("total_units")
  costPerUnit       Decimal            @map("cost_per_unit") @db.Decimal(18, 4)
  source            FullShipmentSource @default(manual)
  mlInboundId       String?            @unique @map("ml_inbound_id")
  productCount      Int?               @map("product_count")
  billingYear       Int?               @map("billing_year")
  billingMonth      Int?               @map("billing_month")
  mlChargeDetailId  String?            @map("ml_charge_detail_id")
  notes             String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([shippedAt])
  @@index([billingYear, billingMonth])
  @@index([organizationId])
  @@map("full_shipments")
}

/// Ciclo operacional por anúncio (compra ou envio Full), independente por kind.
model ReplenishmentCycle {
  id                    String              @id @default(cuid())
  organizationId        String              @map("organization_id")
  mlItemId              String              @map("ml_item_id")
  kind                  OperationCycleKind
  status                ReplenishmentStatus
  triggerMlQty          Int                 @map("trigger_ml_qty")
  triggerWarehouseQty   Int                 @map("trigger_warehouse_qty")
  triggerLeadTimeDays   Int?                @map("trigger_lead_time_days")
  triggerPurchaseAt     DateTime?           @map("trigger_purchase_at")
  warehouseQtyAtOrder   Int?                @map("warehouse_qty_at_order")
  /// Estoque ML ao marcar Coletado (baseline para detectar entrada no Full).
  mlQtyAtCollection     Int?                @map("ml_qty_at_collection")
  suggestedQty          Int?                @map("suggested_qty")
  notes                 String?
  completedMlQty        Int?                @map("completed_ml_qty")
  completedWarehouseQty Int?                @map("completed_warehouse_qty")
  completedLeadTimeDays Int?                @map("completed_lead_time_days")
  completedAt           DateTime?           @map("completed_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  listing Listing @relation(fields: [mlItemId], references: [mlItemId], onDelete: Cascade)

  @@index([mlItemId, kind, status])
  @@index([status])
  @@index([organizationId])
  @@map("replenishment_cycles")
}

model CatalogCompetitionSnapshot {
  id             String                   @id @default(cuid())
  organizationId String                   @map("organization_id")
  mlItemId       String                   @map("ml_item_id")
  status         CatalogCompetitionStatus
  sellerPrice    Decimal?                 @map("seller_price") @db.Decimal(18, 2)
  priceToWin     Decimal?                 @map("price_to_win") @db.Decimal(18, 2)
  snapshotAt     DateTime                 @default(now()) @map("snapshot_at")
  source         CatalogCompetitionSource @default(manual_poll)
  rawResponse    Json                     @map("raw_response")

  listing Listing @relation(fields: [mlItemId], references: [mlItemId], onDelete: Cascade)

  @@unique([mlItemId, snapshotAt])
  @@index([snapshotAt(sort: Desc)])
  @@index([mlItemId, snapshotAt(sort: Desc)])
  @@index([organizationId])
  @@map("catalog_competition_snapshots")
}

/// Log de execuções do poll de competição de catálogo (cron ou manual).
model CatalogCompetitionPollRun {
  id             String                   @id @default(cuid())
  organizationId String                   @map("organization_id")
  ranAt          DateTime                 @default(now()) @map("ran_at")
  source         CatalogCompetitionSource
  itemsChecked   Int                      @default(0) @map("items_checked")
  itemsChanged   Int                      @default(0) @map("items_changed")
  ok             Boolean                  @default(true)
  errorSummary   String?                  @map("error_summary") @db.Text

  @@index([ranAt(sort: Desc)])
  @@index([organizationId])
  @@map("catalog_competition_poll_runs")
}

/// Estoque físico no galpão (1:1 com listing).
model WarehouseStock {
  mlItemId             String   @id @map("ml_item_id")
  organizationId       String   @map("organization_id")
  quantity             Int      @default(0)
  /// Prazo compra → chegada no galpão (dias inteiros; UI pode informar em semanas).
  purchaseLeadTimeDays Int?     @map("purchase_lead_time_days")
  /// Override opcional dos dias de cobertura alvo na análise de compra.
  targetCoverageDays   Int?     @map("target_coverage_days")
  notes                String?
  updatedAt            DateTime @updatedAt @map("updated_at")

  listing Listing @relation(fields: [mlItemId], references: [mlItemId], onDelete: Cascade)

  @@index([organizationId])
  @@map("warehouse_stock")
}

/// Faixas de custo Flex por distância (tabela pré-existente, capturada aqui para alinhar com o schema).
/// Global — definida pelo próprio Mercado Livre, igual para todo seller. Sem organizationId.
model FlexDistanceTier {
  id          String   @id
  name        String
  carrierCost Decimal  @map("carrier_cost") @db.Decimal(18, 2)
  mlBonus     Decimal  @map("ml_bonus") @db.Decimal(18, 2)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("flex_distance_tiers")
}

enum TaxRegime {
  LUCRO_REAL      @map("lucro_real")
  LUCRO_PRESUMIDO @map("lucro_presumido")
  SIMPLES         @map("simples")
}

/// Cadastro fiscal/comercial por SKU (chave = SKU do anúncio ML).
/// PK sintética (`id`) + unique composto `(organizationId, sku)` — dois
/// vendedores diferentes podem usar o mesmo SKU.
model Product {
  id                  String   @id @default(cuid())
  organizationId      String   @map("organization_id")
  sku                 String
  ncm                 String?
  unitCostNf          Decimal  @map("unit_cost_nf") @db.Decimal(18, 2)
  purchaseIcmsPercent Decimal  @map("purchase_icms_percent") @db.Decimal(8, 4)
  hasIcmsSt           Boolean  @default(false) @map("has_icms_st")
  purchaseCostWithSt  Decimal? @map("purchase_cost_with_st") @db.Decimal(18, 2)
  ipiPercent          Decimal  @default(0) @map("ipi_percent") @db.Decimal(8, 4)
  extraCosts          Decimal  @default(0) @map("extra_costs") @db.Decimal(18, 2)
  isMonophasic        Boolean  @default(false) @map("is_monophasic")
  saleIcmsPercent     Decimal  @map("sale_icms_percent") @db.Decimal(8, 4)
  isImported          Boolean  @default(false) @map("is_imported")
  pmaPrice            Decimal? @map("pma_price") @db.Decimal(18, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  skuAliases       ProductSkuAlias[]        @relation("ProductCanonicalSku")
  kitItems         KitItem[]
  dreCostLevelings DreProductCostLeveling[]

  @@unique([organizationId, sku])
  @@map("products")
}

/// Anúncio "kit" do Mercado Livre (sem SKU próprio) cadastrado manualmente com
/// os SKUs componentes, pois a API do ML não expõe essa composição.
model Kit {
  mlItemId       String   @id @map("ml_item_id")
  organizationId String   @map("organization_id")
  title          String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  items KitItem[]

  @@index([organizationId])
  @@map("kits")
}

model KitItem {
  kitId          String  @map("kit_id")
  sku            String
  organizationId String  @map("organization_id")
  quantity       Decimal @default(1) @db.Decimal(18, 4)

  kit     Kit     @relation(fields: [kitId], references: [mlItemId], onDelete: Cascade)
  product Product @relation(fields: [organizationId, sku], references: [organizationId, sku], onDelete: Cascade)

  @@id([kitId, sku])
  @@index([sku])
  @@index([organizationId])
  @@map("kit_items")
}

/// SKU antigo/alternativo que aponta para o cadastro canônico em products.
/// `aliasSku` também deixa de ser globalmente único pelo mesmo motivo do
/// `Product.sku` — dois vendedores podem ter usado o mesmo SKU antigo.
model ProductSkuAlias {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  aliasSku       String   @map("alias_sku")
  canonicalSku   String   @map("canonical_sku")
  createdAt      DateTime @default(now()) @map("created_at")

  product Product @relation("ProductCanonicalSku", fields: [organizationId, canonicalSku], references: [organizationId, sku], onDelete: Cascade)

  @@unique([organizationId, aliasSku])
  @@index([canonicalSku])
  @@map("product_sku_aliases")
}

/// Configuração fiscal — uma linha por organização (o antigo singleton
/// `id: "default"` deixou de existir; `id` agora é um cuid qualquer,
/// `organizationId` é a chave de negócio real).
model CompanyTaxSettings {
  id                              String    @id @default(cuid())
  organizationId                  String    @map("organization_id")
  pisCofinsPercent                Decimal   @map("pis_cofins_percent") @db.Decimal(8, 4)
  taxRegime                       TaxRegime @default(LUCRO_REAL) @map("tax_regime")
  originUf                        String    @default("SP") @map("origin_uf")
  pisRatePercent                  Decimal   @default(1.65) @map("pis_rate_percent") @db.Decimal(8, 4)
  cofinsRatePercent               Decimal   @default(7.6) @map("cofins_rate_percent") @db.Decimal(8, 4)
  excludeIcmsFromPisCofinsBase    Boolean   @default(true) @map("exclude_icms_from_pis_cofins_base")
  considerIcmsStRecuperavel       Boolean   @default(true) @map("consider_icms_st_recuperavel")
  irpjAdditionalThreshold         Decimal   @default(20000) @map("irpj_additional_threshold") @db.Decimal(18, 2)
  wholesaleLevel1ReductionPercent Decimal   @default(10) @map("wholesale_level1_reduction_percent") @db.Decimal(8, 4)
  wholesaleLevel2ReductionPercent Decimal   @default(15) @map("wholesale_level2_reduction_percent") @db.Decimal(8, 4)
  wholesaleLevel3ReductionPercent Decimal   @default(20) @map("wholesale_level3_reduction_percent") @db.Decimal(8, 4)
  wholesaleLevel1MinPurchaseUnit  Int       @default(1) @map("wholesale_level1_min_purchase_unit")
  wholesaleLevel2MinPurchaseUnit  Int       @default(5) @map("wholesale_level2_min_purchase_unit")
  wholesaleLevel3MinPurchaseUnit  Int       @default(10) @map("wholesale_level3_min_purchase_unit")
  /// Alíquota efetiva do DAS (Simples Nacional), informada manualmente pela
  /// empresa — v1 não implementa as tabelas oficiais de Anexo/Faixa/Fator R
  /// (LC 123/2006). `null` = regime Simples selecionado mas alíquota ainda
  /// não configurada; nunca usar 0 como default silencioso desse estado.
  simplesAliquotaEfetivaPercent   Decimal?  @map("simples_aliquota_efetiva_percent") @db.Decimal(8, 4)
  updatedAt                       DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId])
  @@map("company_tax_settings")
}

/// Alíquota interna de ICMS + FCP por UF de destino (configurável).
/// Global por padrão hoje (referência nacional). Design futuro (não
/// implementado ainda — sem cliente pedindo): ganhar `organizationId`
/// opcional para permitir override por organização com regime fiscal
/// especial, mantendo as linhas atuais como padrão nacional
/// (`organizationId: null`). Ver docs/architecture/tenant-data-model.md.
model IcmsInternalRate {
  uf           String   @id
  aliquotaBase Decimal  @map("aliquota_base") @db.Decimal(8, 4)
  fcp          Decimal  @default(0) @db.Decimal(8, 4)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("icms_internal_rates")
}

/// Vigência CBS/IBS por ano (informativo / reforma tributária). Global —
/// alíquotas legais, iguais para qualquer empresa. Sem organizationId.
model CbsIbsVigencia {
  year             Int      @id
  cbsRate          Decimal? @map("cbs_rate") @db.Decimal(8, 4)
  ibsEstadualRate  Decimal? @map("ibs_estadual_rate") @db.Decimal(8, 4)
  ibsMunicipalRate Decimal? @map("ibs_municipal_rate") @db.Decimal(8, 4)
  notes            String?  @db.Text
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("cbs_ibs_vigencia")
}

/// Snapshot mensal do relatório tributário por vendedor ML.
model TaxReportMonthSnapshot {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  sellerId       Int      @map("seller_id")
  year           Int
  month          Int
  generatedAt    DateTime @map("generated_at")
  payload        Json
  /// Mesmo payload, mas com `porSku[].transacoes` removido — usado por leituras
  /// "ao vivo" (Produtos, DRE, Avaliação Financeira) que só precisam de agregados
  /// por SKU, evitando trafegar o detalhamento por venda do banco. Nullable para
  /// snapshots antigos ainda não migrados (backfill).
  payloadSummary Json?    @map("payload_summary")

  @@unique([sellerId, year, month])
  @@index([year, month])
  @@index([organizationId])
  @@map("tax_report_month_snapshots")
}

/// Simulação "e se essa empresa Simples Nacional fosse Lucro Real" — roda o
/// motor de apuração do Lucro Real (`generateMonthlyTaxReport` com
/// `forceRegime`) sobre os dados reais do mês, só para comparação. Tabela
/// fisicamente separada de `TaxReportMonthSnapshot` de propósito: nunca deve
/// ser lida por Produtos/Lucratividade/DRE, que esperam o regime real da org.
model TaxReportSimulationSnapshot {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  sellerId       Int      @map("seller_id")
  year           Int
  month          Int
  /// Reservado para cenários futuros além de "LUCRO_REAL" (ex.: outro Anexo).
  scenario       String   @default("LUCRO_REAL") @map("scenario")
  generatedAt    DateTime @map("generated_at")
  payload        Json
  payloadSummary Json?    @map("payload_summary")

  @@unique([organizationId, sellerId, year, month, scenario])
  @@index([organizationId])
  @@map("tax_report_simulation_snapshots")
}

/// Cache de receita mensal pro cálculo de RBT12 (Simples Nacional) — mês
/// fechado é imutável na prática, então uma vez calculado não precisa
/// recomputar em toda visita (evita 12 chamadas ao ML por acesso à tela).
/// Botão "Atualizar" na UI força recálculo e sobrescreve.
model SimplesRevenueMonthSnapshot {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  sellerId       Int      @map("seller_id")
  year           Int
  month          Int
  revenue        Decimal  @db.Decimal(18, 2)
  /// "dre_snapshot" | "ml_live" — de onde veio o valor na última vez que foi calculado.
  source         String
  computedAt     DateTime @map("computed_at")

  @@unique([organizationId, sellerId, year, month])
  @@index([organizationId])
  @@map("simples_revenue_month_snapshots")
}

/// Simulação salva de potencial de faturamento / capital de giro (overrides,
/// exclusões e configurações de capital de giro), por vendedor ML.
model RevenueSimulation {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  sellerId       Int      @map("seller_id")
  name           String
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([sellerId])
  @@index([organizationId])
  @@map("revenue_simulations")
}

/// Cache de verificação de contribuinte ICMS por CNPJ. Global — é sobre o
/// CNPJ consultado, não sobre o tenant que consultou. Sem organizationId.
model TaxpayerVerificationCache {
  cnpj          String   @id
  isContributor Boolean  @map("is_contributor")
  provider      String
  expiresAt     DateTime @map("expires_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("taxpayer_verification_cache")
}

/// Avisos de estoque que já receberam ação operacional (ex.: compra feita).
model StockAttentionAcknowledgement {
  id                   String             @id @default(cuid())
  organizationId       String             @map("organization_id")
  mlItemId             String             @map("ml_item_id")
  kind                 StockAttentionKind
  mlAvailableQuantity  Int                @map("ml_available_quantity")
  warehouseQuantity    Int                @map("warehouse_quantity")
  purchaseLeadTimeDays Int?               @map("purchase_lead_time_days")
  acknowledgedAt       DateTime           @default(now()) @map("acknowledged_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  listing Listing @relation(fields: [mlItemId], references: [mlItemId], onDelete: Cascade)

  @@unique([mlItemId, kind])
  @@index([kind])
  @@index([organizationId])
  @@map("stock_attention_acknowledgements")
}

/// Tokens OAuth do vendedor ML (até 1 linha por `ml_user_id`) para chamadas server-side (ex.: webhook).
/// `refresh_enc` / `access_enc` são texto cifrado (AES-256-GCM) com `ENCRYPTION_KEY`.
/// Global por design — storage de token por conta ML, não por org;
/// `OrganizationMlSeller` é a ponte entre esta tabela e a organização.
model MlSellerCredentials {
  mlUserId        Int       @id @map("ml_user_id")
  refreshEnc      String    @map("refresh_enc") @db.Text
  accessEnc       String?   @map("access_enc") @db.Text
  accessExpiresAt DateTime? @map("access_expires_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("ml_seller_credentials")
}

/// Item de custo manual do DRE (fixo ou operacional; valor por mês em DreCostMonthValue).
model DreCostItem {
  id             String              @id @default(cuid())
  organizationId String              @map("organization_id")
  name           String
  section        DreCostSection      @default(FIXED)
  sortOrder      Int                 @default(0) @map("sort_order")
  active         Boolean             @default(true)
  /// true = valor informado se replica nos meses seguintes; false = só vale no mês com valor explícito.
  recurring      Boolean             @default(true)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  monthValues    DreCostMonthValue[]

  @@index([section, active])
  @@index([organizationId])
  @@map("dre_cost_items")
}

enum DreCostSection {
  FIXED               @map("fixed")
  OPERATIONAL         @map("operational")
  INVESTMENT          @map("investment")
  NON_OPERATIONAL_OUT @map("non_operational_out")
  NON_OPERATIONAL_IN  @map("non_operational_in")
}

/// Preferências de exibição do DRE por organização — puramente visual, nunca afeta o cálculo.
model DreDisplaySettings {
  id                    String   @id @default(cuid())
  organizationId        String   @unique @map("organization_id")
  showInvestments       Boolean  @default(true) @map("show_investments")
  showNonOperationalOut Boolean  @default(true) @map("show_non_operational_out")
  showNonOperationalIn  Boolean  @default(true) @map("show_non_operational_in")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("dre_display_settings")
}

model DreCostMonthValue {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  costItemId     String      @map("cost_item_id")
  year           Int
  month          Int
  amount         Decimal     @db.Decimal(18, 2)
  costItem       DreCostItem @relation(fields: [costItemId], references: [id], onDelete: Cascade)

  @@unique([costItemId, year, month])
  @@index([year, month])
  @@index([organizationId])
  @@map("dre_cost_month_values")
}

/// Item de custo fixo cadastrado pra gerar crédito de PIS/COFINS (ex.: aluguel).
model TaxFixedCostItem {
  id             String                       @id @default(cuid())
  organizationId String                       @map("organization_id")
  name           String
  sortOrder      Int                          @default(0) @map("sort_order")
  active         Boolean                      @default(true)
  /// true = repete todo mês até ser alterado/removido; false = só vale nos meses com valor explícito.
  recurring      Boolean                      @default(true)
  /// Se setado, o item deixa de se aplicar a partir de (endYear, endMonth) inclusive — "Encerrar gasto fixo".
  endYear        Int?                         @map("end_year")
  endMonth       Int?                         @map("end_month")
  createdAt      DateTime                     @default(now()) @map("created_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")
  monthValues    TaxFixedCostMonthValue[]
  exclusions     TaxFixedCostMonthExclusion[]

  @@index([active])
  @@index([organizationId])
  @@map("tax_fixed_cost_items")
}

model TaxFixedCostMonthValue {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  costItemId     String           @map("cost_item_id")
  year           Int
  month          Int
  amount         Decimal          @db.Decimal(18, 2)
  costItem       TaxFixedCostItem @relation(fields: [costItemId], references: [id], onDelete: Cascade)

  @@unique([costItemId, year, month])
  @@index([year, month])
  @@index([organizationId])
  @@map("tax_fixed_cost_month_values")
}

/// Marca um mês específico como excluído do crédito pra um item recorrente,
/// sem interromper a herança de valor pros meses seguintes ("Remover valor deste mês").
model TaxFixedCostMonthExclusion {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  costItemId     String           @map("cost_item_id")
  year           Int
  month          Int
  costItem       TaxFixedCostItem @relation(fields: [costItemId], references: [id], onDelete: Cascade)

  @@unique([costItemId, year, month])
  @@index([year, month])
  @@index([organizationId])
  @@map("tax_fixed_cost_month_exclusions")
}

/// Snapshot mensal do DRE após sync (linhas ML + ERP + ADS). O unique global
/// `[year, month]` vira `[organizationId, year, month]` na Fase 2.
model DreMonthSnapshot {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  year           Int
  month          Int
  syncedAt       DateTime @map("synced_at")
  payload        Json

  @@unique([organizationId, year, month])
  @@index([year, month])
  @@map("dre_month_snapshots")
}

/// Nivelamento de custo unitário por SKU e intervalo de datas — só o DRE usa.
/// Fora do intervalo, o sync continua com o cadastro atual em `Product`.
model DreProductCostLeveling {
  id                 String   @id @default(cuid())
  organizationId     String   @map("organization_id")
  sku                String
  startDate          DateTime @map("start_date") @db.Date
  endDate            DateTime @map("end_date") @db.Date
  hasIcmsSt          Boolean  @default(false) @map("has_icms_st")
  unitCostNf         Decimal  @map("unit_cost_nf") @db.Decimal(18, 2)
  purchaseCostWithSt Decimal? @map("purchase_cost_with_st") @db.Decimal(18, 2)
  ipiPercent         Decimal  @default(0) @map("ipi_percent") @db.Decimal(8, 4)
  /// Campos abaixo: histórico completo do cadastro do produto (exceto NCM,
  /// que não varia no tempo). Nullable = "não informado" em registros
  /// antigos. Não usados no cálculo do DRE hoje (só custo/ICMS-ST/IPI acima
  /// são usados) — persistidos para uso futuro de Margem/Relatório Tributário.
  purchaseIcmsPercent Decimal? @map("purchase_icms_percent") @db.Decimal(8, 4)
  extraCosts          Decimal? @map("extra_costs") @db.Decimal(18, 2)
  isMonophasic        Boolean? @map("is_monophasic")
  saleIcmsPercent     Decimal? @map("sale_icms_percent") @db.Decimal(8, 4)
  isImported          Boolean? @map("is_imported")
  pmaPrice            Decimal? @map("pma_price") @db.Decimal(18, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [organizationId, sku], references: [organizationId, sku], onDelete: Cascade)

  @@index([sku])
  @@index([startDate, endDate])
  @@index([organizationId])
  @@map("dre_product_cost_levelings")
}

enum DreReconciliationImportStatus {
  pending
  confirmed
  superseded
}

/// Upload da planilha de conciliação ML (Por Vendas) para um mês do DRE.
model DreReconciliationImport {
  id                   String                         @id @default(cuid())
  organizationId       String                         @map("organization_id")
  year                 Int
  month                Int
  fileName             String                         @map("file_name")
  sheetName            String                         @map("sheet_name")
  rowCount             Int                            @map("row_count")
  status               DreReconciliationImportStatus  @default(pending)
  aggregationJson      Json                           @map("aggregation_json")
  parseWarningsJson    Json?                          @map("parse_warnings_json")
  previousPayloadJson  Json?                          @map("previous_payload_json")
  acceptedLineKeysJson Json?                          @map("accepted_line_keys_json")
  appliedAt            DateTime?                      @map("applied_at")
  uploadedAt           DateTime                       @default(now()) @map("uploaded_at")
  confirmedAt          DateTime?                      @map("confirmed_at")
  createdAt            DateTime                       @default(now()) @map("created_at")
  updatedAt            DateTime                       @updatedAt @map("updated_at")

  entries DreReconciliationEntry[]

  @@index([organizationId, year, month, status])
  @@map("dre_reconciliation_imports")
}

model DreReconciliationEntry {
  id                 String   @id @default(cuid())
  importId           String   @map("import_id")
  organizationId     String   @map("organization_id")
  rowIndex           Int      @map("row_index")
  operationDate      DateTime? @map("operation_date") @db.Date
  operationId        String   @map("operation_id")
  operationType      String   @map("operation_type")
  operationStatus    String?  @map("operation_status")
  sku                String?
  itemTitle          String?  @map("item_title")
  quantity           Int?
  grossValue         Decimal? @map("gross_value") @db.Decimal(18, 2)
  totalFees          Decimal? @map("total_fees") @db.Decimal(18, 2)
  totalPostpaidFees  Decimal? @map("total_postpaid_fees") @db.Decimal(18, 2)
  sellerPaidShipping Decimal? @map("seller_paid_shipping") @db.Decimal(18, 2)
  mappedLineKey      String?  @map("mapped_line_key")
  mappedAmount       Decimal? @map("mapped_amount") @db.Decimal(18, 2)
  rawJson            Json     @map("raw_json")

  import DreReconciliationImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([organizationId, importId])
  @@index([importId, mappedLineKey])
  @@map("dre_reconciliation_entries")
}
